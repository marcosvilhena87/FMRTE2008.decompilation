{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "issued_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "maxItems": 10000
    }
  },
  "required": [
    "sequence",
    "issued_utc",
    "expires_utc",
    "revoked"
  ],
  "additionalProperties": false
}
