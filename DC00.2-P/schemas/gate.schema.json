{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "authority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "scope": {
      "enum": [
        "synthetic_homologation"
      ]
    },
    "decision": {
      "enum": [
        "allow",
        "deny"
      ]
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolchain_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "decision_id",
    "authority",
    "scope",
    "decision",
    "fixture_sha256",
    "protocol_sha256",
    "toolchain_sha256",
    "evidence_sha256",
    "issued_utc",
    "expires_utc"
  ],
  "additionalProperties": false
}
